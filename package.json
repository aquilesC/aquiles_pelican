{
  "name": "aquiles-pelican",
  "version": "1.0.0",
  "description": "Personal static website with Pelican and TailwindCSS",
  "scripts": {
    "build:css": "tailwindcss -i ./themes/aquiles_theme/static/css/src/input.css -o ./themes/aquiles_theme/static/css/style.css --minify",
    "watch:css": "tailwindcss -i ./themes/aquiles_theme/static/css/src/input.css -o ./themes/aquiles_theme/static/css/style.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  },
  "keywords": [
    "pelican",
    "static-site",
    "tailwindcss"
  ],
  "author": "Aquiles",
  "license": "MIT"
}
